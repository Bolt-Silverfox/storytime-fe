# Backend API base URL — WITHOUT the /api/v1 suffix (lib/axios.ts appends it).
# green / current dev : https://dev.api.storytimeapp.me
# blue  / v1.3.0      : https://blue.dev.api.storytimeapp.me
# NOTE: NEXT_PUBLIC_* is inlined at BUILD time, so the blue build must be built
# with the blue value (see .env.blue and scripts/deploy-blue-green.sh).
NEXT_PUBLIC_API_URL=https://dev.api.storytimeapp.me

# Optional: short git sha, surfaced by /api/health so you can confirm which
# build a color is serving. The deploy script sets this automatically.
NEXT_PUBLIC_GIT_SHA=
